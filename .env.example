# ============================================
# CONFIGURACIÓN GENERAL DE SREED
# ============================================

# Ruta raíz del proyecto (opcional, por defecto usa el directorio actual)
SREED_ROOT=

# ============================================
# RUTAS DE NEGOCIO (Facturas)
# ============================================

# Carpeta de entrada (monitoreada por watchdog)
SREED_INPUT_DIR=invoices/input

# Carpeta de procesados exitosamente
SREED_PROCESSED_DIR=invoices/processed

# Carpeta de fallidos
SREED_FAILED_DIR=invoices/failed

# ============================================
# RUTAS TÉCNICAS (Recursos)
# ============================================

# Base de datos vectorial FAISS
SREED_FAISS_DIR=resources/faiss

# Logs del sistema
SREED_LOG_DIR=resources/logs

# Modelos de Ollama (Modelfiles)
SREED_MODELS_DIR=resources/models

# ============================================
# CONFIGURACIÓN DE OLLAMA / QWEN
# ============================================

# Host del servidor Ollama
SREED_OLLAMA_HOST=http://localhost:11434

# Modelo principal para estructuración
SREED_PRIMARY_MODEL=qwen3.5:9b

# Modelo de fallback si el principal falla
SREED_FALLBACK_MODEL=qwen2.5:7b

# Tamaño de ventana de contexto (tokens)
SREED_CONTEXT_WINDOW=4096

# Timeout para llamadas a Ollama (segundos)
SREED_LLM_TIMEOUT=120

# ============================================
# CONFIGURACIÓN DE OCR
# ============================================

# Idiomas para OCR (separados por coma)
SREED_OCR_LANGUAGES=es,en

# Usar GPU para OCR (true/false)
SREED_USE_GPU=true

# DPI para conversión de PDFs a imágenes
SREED_PDF_DPI=200

# ============================================
# CONFIGURACIÓN DE FAISS / RAG
# ============================================

# Nombre de la colección en FAISS
SREED_FAISS_COLLECTION=sreed_documents

# Número de documentos a recuperar en RAG
SREED_RAG_TOP_K=5

# ============================================
# CONFIGURACIÓN DE GEMINI (OPCIONAL - MODO HÍBRIDO)
# ============================================

# API Key de Gemini (solo si se usa modo qwen_gemini)
# SREED_GEMINI_API_KEY=

# Modelo de Gemini a usar
# SREED_GEMINI_MODEL=gemini-flash-latest

# ============================================
# MODO DE OPERACIÓN
# ============================================

# Modo de operación: qwen_only | qwen_gemini
# qwen_only: Solo Qwen local (recomendado para privacidad)
# qwen_gemini: Qwen + Gemini para validación cruzada
SREED_LLM_MODE=qwen_only

# ============================================
# LOGGING
# ============================================

# Nivel de logging: DEBUG | INFO | WARNING | ERROR
SREED_LOG_LEVEL=INFO